{
  "name": "@luma-dev/eslint-plugin-luma-ts",
  "version": "0.0.0-dev",
  "publishConfig": {
    "access": "public"
  },
  "description": "ESLint plugin for TypeScript with luma",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "files": [
    "lib"
  ],
  "homepage": "https://github.com/luma-dev/eslint-plugin-luma-ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/luma-dev/eslint-plugin-luma-ts.git"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest",
    "test-cov": "vitest --coverage",
    "lint": "eslint src && prettier . --list-different",
    "lint-fix": "eslint src && prettier . --write",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "eslint",
    "eslintplugin",
    "typescript"
  ],
  "author": "Luma <world@luma.email>",
  "license": "MIT",
  "dependencies": {
    "@typescript-eslint/rule-tester": "^8.72.1",
    "@typescript-eslint/utils": "^8.72.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.13.0",
    "prettier": "^3.9.10",
    "semantic-release": "^25.0.9",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  },
  "peerDependencies": {
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0 || ^10.0.0",
    "typescript": "^5.0.0 || ^6.0.0"
  }
}
